# Data ID: momentliving-common.yaml
# 只提交占位符，真实密码和密钥填在 Nacos 或环境变量中。
spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: ${MYSQL_URL:jdbc:mysql://127.0.0.1:3306/momentliving?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai}
    username: ${MYSQL_USERNAME:momentliving}
    password: ${MYSQL_PASSWORD}
  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD}
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0
mybatis-plus:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.momentliving.entity
  configuration:
    map-underscore-to-camel-case: true

momentliving:
  jwt:
    secret: ${JWT_SECRET}
    access-token-ttl: 30
    refresh-token-ttl: 7
    token-name: authorization
  internal-auth:
    enabled: true
    secret: ${INTERNAL_AUTH_SECRET}
    max-clock-skew-seconds: 60
