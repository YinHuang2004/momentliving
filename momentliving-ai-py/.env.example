# ===== 应用 =====
APP_NAME=momentliving-ai-py
APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8093

# ===== LLM（OpenAI 兼容协议）=====
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-please-fill
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ===== Embedding（中文推荐硅基流动 bge-m3，1024 维，与 scripts/init_db.sql 的 vector(1024) 对齐）=====
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=sk-please-fill
EMBED_MODEL=Pro/BAAI/bge-m3
EMBED_DIM=1024

# ===== PostgreSQL（Pgvector）=====
PG_HOST=localhost
PG_PORT=5433
PG_USER=momentliving
PG_PASSWORD=momentliving123
PG_DATABASE=momentliving_ai

# ===== Redis（会话滑动窗口）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 业务微服务（Java 上游，直连不经过网关）=====
SHOP_SERVICE_URL=http://localhost:8082
BLOG_SERVICE_URL=http://localhost:8087
VOUCHER_SERVICE_URL=http://localhost:8085
MERCHANT_SERVICE_URL=http://localhost:8084
UPSTREAM_TIMEOUT=10

# ===== Nacos（网关 lb://ai-py-service 依赖本注册；本地不起网关可关）=====
NACOS_ENABLED=false
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=3ad86f15-1b9c-4576-a3f2-d98780feffdc
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ===== 业务配置（替代 momentliving.ai.*）=====
AI_ENABLED=true
AI_RAG_ENABLED=true
AI_RAG_TOP_K=5
AI_HISTORY_ROUNDS=10
AI_KNOWLEDGE_MAX_CHARS=1500
AI_SSE_TIMEOUT_MS=60000
