<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.momentliving</groupId>
        <artifactId>momentliving</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>momentliving-gateway</artifactId>
    <name>momentliving-gateway</name>
    <description>网关服务：统一入口、路由转发、JWT 鉴权（Spring Cloud Gateway）</description>

    <dependencies>
        <!-- Spring Cloud Gateway（WebFlux 响应式网关）⚠️ 不能与 spring-boot-starter-web 共存 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>

        <!-- Nacos 服务发现：从 Nacos 拉取下游服务列表，供 lb:// 路由解析 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- LoadBalancer（Spring Cloud 2021+ 需显式引入）：lb:// 负载均衡 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <dependency>
            <groupId>com.momentliving</groupId>
            <artifactId>momentliving-common</artifactId>
        </dependency>

        <!-- Redis：网关鉴权时查登录态 + 续期（StringRedisTemplate） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- JWT（Auth0）：解析 AccessToken 获取 userId -->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
