<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.momentliving.mapper.ShopMapper">

    <!-- 按传入 id 顺序查询店铺列表 -->
    <select id="selectShopByIds" resultType="Shop">
        select * from shop where id in <foreach collection="list" item="shopId" separator="," open="(" close=")" >
        #{shopId}
    </foreach>
        order by field(id,<foreach collection="list" item="shopId" separator=",">
            #{shopId}
    </foreach>)
    </select>

</mapper>
