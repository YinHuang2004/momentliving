<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.momentliving</groupId>
    <artifactId>momentliving</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>momentliving</name>
    <description></description>

    <modules>
        <module>momentliving-common</module>
        <module>momentliving-pojo</module>
        <module>momentliving-api</module>
        <!-- 🆕 微服务拆分：4 个业务服务 -->
        <module>momentliving-user-service</module>
        <module>momentliving-shop-service</module>
        <module>momentliving-blog-service</module>
        <module>momentliving-voucher-service</module>
        <!-- 🆕 管理端服务（平台管理员：入驻审核/上架/订单/看板） -->
        <module>momentliving-admin-service</module>
        <!-- 🆕 商家端服务（merchant 表账号体系：商家登录/核销/工作台/入驻申请） -->
        <module>momentliving-merchant-service</module>
        <!-- 🆕 文件服务（统一上传：博客图/店铺图/头像/券图/评价图 → 阿里云 OSS） -->
        <module>momentliving-file-service</module>
        <!-- 🆕 即时聊天服务（WebSocket 单聊/群聊/首条限制/博客卡片） -->
        <module>momentliving-chat-service</module>
        <!-- 🆕 AI 助手服务（Spring AI：业务问答/推荐/内容生成/经营分析） -->
        <module>momentliving-ai-service</module>
        <!-- 🆕 网关：统一入口 + 路由转发 + JWT 鉴权 -->
        <module>momentliving-gateway</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <redisson.version>3.27.2</redisson.version>
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <java-jwt.version>4.4.0</java-jwt.version>
        <springdoc.version>2.3.0</springdoc.version>
        <hutool.version>5.8.27</hutool.version>
        <mysql.version>8.0.33</mysql.version>
        <!-- 🆕 微服务：Spring Cloud & Alibaba 版本（对应 Spring Boot 3.2.x） -->
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.1.0</spring-cloud-alibaba.version>
        <!-- 🆕 支付对接：支付宝官方 SDK（沙箱）/ 微信支付 APIv3 SDK（商户号预留） -->
        <alipay-sdk.version>4.40.978.ALL</alipay-sdk.version>
        <wechatpay-java.version>0.2.17</wechatpay-java.version>
        <!-- 🆕 Spring AI（里程碑版，需 spring-milestones 仓库；与 Spring Boot 3.2.x 兼容） -->
        <spring-ai.version>1.0.0-M6</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 🆕 Spring Cloud BOM：统一管理 OpenFeign/Gateway/LoadBalancer 版本 -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 🆕 Spring Cloud Alibaba BOM：统一管理 Nacos/Sentinel 版本 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 🆕 Spring AI BOM：统一管理 ChatClient/OpenAI starter/嵌入模型版本 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 🆕 显式钉住 core 版本：spring-cloud-alibaba BOM 自带 spring-ai-core 0.8.1 的管理
                 （供它的 ai 模块用），会覆盖 spring-ai-bom 的版本导致解析失败，这里纠正 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-core</artifactId>
                <version>${spring-ai.version}</version>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.momentliving</groupId>
                <artifactId>momentliving-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.momentliving</groupId>
                <artifactId>momentliving-pojo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.momentliving</groupId>
                <artifactId>momentliving-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MySQL 驱动 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!-- Redisson (裸包：不引入自动配置，手动管理 RedissonClient) -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- MyBatis-Plus Spring Boot 3 Starter（业务服务用：含 MyBatis + JDBC 自动配置） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus 纯注解包（momentliving-pojo 用：只有 @TableName/@TableId/@TableField，
                 不带 MyBatis/JDBC 自动配置，避免把 DataSource 传递进 Gateway） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>


            <!-- JWT (Auth0) -->
            <dependency>
                <groupId>com.auth0</groupId>
                <artifactId>java-jwt</artifactId>
                <version>${java-jwt.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI 3 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Hutool -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- 🆕 支付宝官方 SDK（trade.page.pay 页面支付 + RSA2 验签） -->
            <dependency>
                <groupId>com.alipay.sdk</groupId>
                <artifactId>alipay-sdk-java</artifactId>
                <version>${alipay-sdk.version}</version>
            </dependency>
            <!-- 🆕 微信支付 APIv3 官方 SDK（商户号参数预留，未配置不启用） -->
            <dependency>
                <groupId>com.github.wechatpay-apiv3</groupId>
                <artifactId>wechatpay-java</artifactId>
                <version>${wechatpay-java.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 🆕 Spring AI 里程碑版（M6）托管在 Spring 官方里程碑仓库，正式仓库没有 -->
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <!-- 在子模块中实际引入依赖 -->
    <dependencies>
        <!-- Lombok（所有模块共用） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>